@@ -0,0 +1,18 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+package intra
+
+import (
+	"testing"
+
+	"github.com/celzero/firestack/intra/settings"
+)
+
+func TestCaptureDnsPortEnablesAllPort53Interception(t *testing.T) {
+	CaptureDnsPort()
+	if got := settings.DNSMode.Load(); got != settings.DNSModePort {
+		t.Fatalf("DNSMode = %d, want %d (port capture)", got, settings.DNSModePort)
+	}
+}

