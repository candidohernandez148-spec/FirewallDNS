+package intra
+
+import "github.com/celzero/firestack/intra/settings"
+
+// CaptureDnsPort makes the DNS handler intercept DNS over UDP and TCP port 53
+// for every destination address, not only the synthetic DNS addresses assigned
+// by Android VpnService. The DNS transport's own upstream sockets are protected
+// by the Android Bridge and therefore do not loop back into the TUN.
+//
+// FirewallDNS uses this entry point so hard-coded resolver IPs receive the same
+// domain policy as Android's configured system resolver.
+func CaptureDnsPort() {
+	settings.SetTunMode(settings.DNSModePort, settings.BlockModeNone, settings.PtModeNone)
+}
